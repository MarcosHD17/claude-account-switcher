{
  "manifest_version": 3,
  "name": "Claude Account Switcher",
  "version": "1.0.0",
  "description": "Alterna entre varias cuentas de claude.ai en la misma ventana, sin abrir otros navegadores ni perfiles.",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cuentas de Claude"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "cycle-account": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Cambiar a la siguiente cuenta de Claude"
    }
  }
}
